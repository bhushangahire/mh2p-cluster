# Wrapper for `gal` that sets LD_PRELOAD=gal_cluster.so before execing the
# real gal binary. Installed by install.sh; the original is preserved at
# /mnt/app/eso/bin/apps/gal.real. uninstall.sh restores the original.

GAL_PRELOAD="/mnt/app/eso/bin/apps/cluster/gal_cluster.so"
GAL_PRELOAD_LOG="/tmp/gal_preload.log"

echo -e "\ngal_date: $(date)"  >> $GAL_PRELOAD_LOG

if [ -f $GAL_PRELOAD ]; then
    export LD_PRELOAD=$GAL_PRELOAD
    echo "gal preload: $GAL_PRELOAD" >> $GAL_PRELOAD_LOG
else
    echo "error preload: $GAL_PRELOAD not found" >> $GAL_PRELOAD_LOG
fi

# Diagnostic mode: marker left by install.sh when Mods/ClusterIntegration/
# diag.txt is on the SD card (install.sh also sets enableMapRender=false in
# the installed config so the Java side does not post an empty cluster
# window). The hook then loads, resolves its symbols and logs the stock
# service discovery, but does not inject the cluster service
# (GAL_CLUSTER_MERGE=0).
# GAL_CLUSTER_LOG is what the shipped v0034 hook reads; GAL_CLUSTER_LOG_ALL is
# the name used by the repo source, exported too so either build logs.
for diag in /mnt/app/eso/bin/apps/cluster/diag_mode; do
    if [ -f "$diag" ]; then
        export GAL_CLUSTER_MERGE=0
        export GAL_CLUSTER_LOG=1
        export GAL_CLUSTER_LOG_ALL=1
        export GAL_CLUSTER_LOG_DETAILS=1
        export GAL_CLUSTER_SD_LOG=1
        echo "gal diag mode: $diag (MERGE=0, logging to /tmp/gal_cluster.log)" >> $GAL_PRELOAD_LOG
        break
    fi
done

# Per-car environment staged by install.sh from Mods/ClusterIntegration/
# gal_env.txt (GAL_CLUSTER_INSET_*, GAL_CLUSTER_LOG=1, ...). Applied after
# the diag block so an explicit value wins.
GAL_ENV=/mnt/app/eso/bin/apps/cluster/gal_env
if [ -f "$GAL_ENV" ]; then
    while read envline; do
        case "$envline" in
            GAL_CLUSTER_[A-Z0-9_]*=*)
                export "$envline"
                echo "gal env: $envline" >> $GAL_PRELOAD_LOG
                ;;
        esac
    done < "$GAL_ENV"
fi

# The cluster daemon is started by the Persist script during a full boot.
# After an HMI restart (MMI knob) or a killed daemon nothing restarts it and
# the cockpit keeps the Audi map, so start it here when it is missing. Only
# one daemon may run (two steal each other's commands): the starter records
# its pid in /tmp/cluster_daemon.pid, checked through /proc/<pid> with shell
# built-ins (pidin/grep are not reliably reachable here, and kill -0 fails
# when this runs as another user than the daemon).
CLUSTER_BIN=/mnt/app/eso/bin/apps/cluster/cluster
DAEMON_PID=/tmp/cluster_daemon.pid
if [ -x "$CLUSTER_BIN" ]; then
    if { read p < "$DAEMON_PID" && [ -n "$p" ] && [ -d "/proc/$p" ]; } 2>/dev/null; then
        echo "cluster daemon: already running (pid $p)" >> $GAL_PRELOAD_LOG
    else
        # verbose=2 (cluster_daemon.log) only with the marker the installer
        # sets from Mods/ClusterIntegration/daemon_log.txt
        V=""
        [ -f /mnt/app/eso/bin/apps/cluster/daemon_verbose ] && V="verbose=2"
        "$CLUSTER_BIN" daemon $V >/dev/null 2>&1 &
        p=$!
        echo $p > "$DAEMON_PID" 2>/dev/null
        echo "cluster daemon: not running, started by the gal wrapper (pid $p, pid file written: $?)" >> $GAL_PRELOAD_LOG
    fi
fi

echo "gal_start: $* LD_PRELOAD: $LD_PRELOAD LD_LIBRARY_PATH:$LD_LIBRARY_PATH" >> $GAL_PRELOAD_LOG

if [ ! -x /mnt/app/eso/bin/apps/gal.real ]; then
    echo "error: /mnt/app/eso/bin/apps/gal.real missing, cannot start gal (restore it from Backup/gal.real on the SD card)" >> $GAL_PRELOAD_LOG
    exit 127
fi

/mnt/app/eso/bin/apps/gal.real "$@"
rc=$?
echo "gal_exit: $rc" >> $GAL_PRELOAD_LOG
exit $rc

